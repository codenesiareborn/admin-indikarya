APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Framework default disk. Keep this on "local" — it backs Livewire/Filament
# temporary uploads. User media is controlled by MEDIA_DISK below.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disk that attendance/patrol/checkpoint photos are written to and read from.
# Migration to cloud storage happens by moving through these settings in order:
#   1. MEDIA_DISK=public  MEDIA_MIRROR_DISK=      (current behaviour, local only)
#   2. MEDIA_DISK=public  MEDIA_MIRROR_DISK=r2    (write both, still read local)
#   3. run the bulk sync, then `php artisan media:verify`
#   4. MEDIA_DISK=r2      MEDIA_MIRROR_DISK=      (cloud only)
MEDIA_DISK=public
MEDIA_MIRROR_DISK=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible). R2_URL must be a custom domain bound to the
# bucket — the pub-*.r2.dev address is development-only and gets throttled.
# Set R2_CHECKSUM_CALCULATION=when_required if uploads fail on checksum headers.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_CHECKSUM_CALCULATION=when_supported

# Cache-Control sent with every object written to cloud storage. Photos use
# unique filenames and are never rewritten, so they are safe to cache forever.
# NOTE: on a Cloudflare R2 custom domain this header alone is not enough — the
# zone also needs a Cache Rule (cache: on, Edge TTL: respect origin), otherwise
# responses stay cf-cache-status: DYNAMIC and every view re-hits the bucket.
MEDIA_CACHE_CONTROL="public, max-age=31536000, immutable"

VITE_APP_NAME="${APP_NAME}"
