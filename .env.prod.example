# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to .env on the production server and fill in the real values:
#
#   cp .env.prod.example .env && php artisan key:generate
#
# THIS FILE IS COMMITTED TO GIT (.gitignore covers .env, .env.backup and
# .env.production — but not this template). Never put real credentials here.
#
# After editing .env on the server, always:
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   sudo systemctl reload php8.4-fpm
# =============================================================================

APP_NAME="Indikarya Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# "daily" + a retention window, not "single": a single laravel.log grows without
# bound and is a common cause of a full disk. LOG_LEVEL must not be "debug" in
# production — it is both noisy and a data-leak risk.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indikarya
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
# SESSION_DOMAIN should be the admin panel's own domain (leading dot only if
# cookies must be shared across subdomains). Define it exactly once — a
# duplicate SESSION_DOMAIN line elsewhere in the file silently wins and breaks
# login in ways that are painful to diagnose.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=admin.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Queue worker must be supervised (supervisor/systemd):
#   php artisan queue:work --queue=default --tries=3 --max-time=3600
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------------------
# Framework default disk. Keep this on "local" — it backs Livewire/Filament
# temporary uploads and report exports, which are read back by absolute path.
# Pointing it at cloud storage will break the Excel/PDF download endpoints.
FILESYSTEM_DISK=local

# Disk that attendance/patrol/checkpoint photos are written to and read from.
#
# ZERO-DOWNTIME CUTOVER — advance one step at a time, running
# `php artisan config:cache` and reloading php-fpm after each:
#
#   1. MEDIA_DISK=public   MEDIA_MIRROR_DISK=        deploy the code; no behaviour change
#   2. MEDIA_DISK=public   MEDIA_MIRROR_DISK=r2      new uploads land on both disks
#   3. bulk-copy the backlog, then confirm the gate passes:
#        rclone copy /var/www/indikarya/storage/app/public/attendances \
#          r2:<bucket>/attendances --transfers=16 --checkers=32 --progress
#        (repeat for patrols/ and checkpoints/; use `copy`, never `sync`)
#        php artisan media:sync-to-cloud
#        php artisan media:verify          # must report GO (exit code 0)
#   4. MEDIA_DISK=r2       MEDIA_MIRROR_DISK=        reads and writes are cloud-only
#
# Rollback at any point: restore MEDIA_DISK=public and MEDIA_MIRROR_DISK=r2.
# Local files are retained, so nothing is lost.
#
# Once cloud-only and soaked, reclaim disk space with:
#   php artisan media:prune-local            # dry run first
#   php artisan media:prune-local --force
MEDIA_DISK=public
MEDIA_MIRROR_DISK=

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage)
# -----------------------------------------------------------------------------
# Use an R2 API token scoped to this bucket with Object Read & Write only —
# not an account-wide token.
#
# R2_URL must be a custom domain bound to the bucket (R2 > Settings > Public
# Access > Custom Domains). The pub-*.r2.dev address is development-only and
# is rate-limited by Cloudflare.
#
# R2_ENDPOINT is the S3 API endpoint and is NOT the same host as R2_URL:
#   https://<account-id>.r2.cloudflarestorage.com
#
# Set R2_CHECKSUM_CALCULATION=when_required only if uploads start failing with
# an x-amz-checksum-crc32 complaint.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=https://cdn.example.com
R2_ENDPOINT=
R2_CHECKSUM_CALCULATION=when_supported

# Cache-Control sent with every object written to cloud storage. Photos use
# unique filenames and are never rewritten, so they are safe to cache forever.
# NOTE: on a Cloudflare R2 custom domain this header alone is not enough — the
# zone also needs a Cache Rule (cache: on, Edge TTL: respect origin), otherwise
# responses stay cf-cache-status: DYNAMIC and every view re-hits the bucket.
MEDIA_CACHE_CONTROL="public, max-age=31536000, immutable"

# Generic S3 disk — unused by this application. Leave blank unless something
# explicitly references Storage::disk('s3').
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Redis (only needed if CACHE_STORE/SESSION_DRIVER/QUEUE_CONNECTION use it)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
